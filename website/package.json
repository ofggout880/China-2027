{
  "name": "china-2027-study-planner",
  "version": "1.0.0",
  "description": "Interactive 3D-animated dark-themed web application to plan and track studying in China in 2027",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "node build.js",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "server": "node server.js",
    "test": "node --test tests/unit/",
    "test:unit": "node --test tests/unit/",
    "test:e2e": "node tests/e2e/run-all.mjs",
    "test:all": "node --test tests/unit/ && node tests/e2e/run-all.mjs"
  },
  "keywords": [
    "china-2027",
    "study-abroad",
    "threejs",
    "webgl",
    "dark-theme",
    "mobile-first"
  ],
  "author": "CHINA 2027 Team",
  "license": "MIT",
  "devDependencies": {
    "vite": "^5.0.0"
  }
}
